@startuml
title "Diagrama de Secuencia - Listar/Abrir Recorridos"

actor "Administrador" as admin
boundary "RecorridoDialog" as view
control "RecorridoController" as controller
control "GestionEspacioService" as service
control "RecorridoRepository" as repository
database "JSON" as db

admin -> view: Abrir gestor de recorridos
activate view
view -> controller: obtenerRecorridos()
activate controller
controller -> service: obtenerRecorridos()
activate service
service -> repository: findAll()
activate repository
repository -> db: Leer recorridos.json
repository --> service: List<Recorrido>
deactivate repository
service --> controller: List<Recorrido>
deactivate service
controller --> view: Lista de recorridos
deactivate controller
view --> admin: Mostrar lista de recorridos
deactivate view

@enduml
