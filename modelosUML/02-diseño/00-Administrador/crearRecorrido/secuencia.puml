@startuml
title "Diagrama de Secuencia - Crear Recorrido"

actor "Administrador" as admin
boundary "RecorridoDialog" as view
control "RecorridoController" as controller
control "RecorridoService" as service
control "RecorridoRepository" as repository
database "JSON" as db

admin -> view: Selecciona "Crear" e ingresa nombre/desc
activate view
view -> controller: crearRecorrido(nombre, desc, idsEspacios)
activate controller
controller -> service: crearRecorrido(nombre, desc, idsEspacios)
activate service
service -> repository: existePorNombre(nombre)
activate repository
repository --> service: boolean
deactivate repository

alt Nombre único
    service -> repository: guardar(nuevoRecorrido)
    activate repository
    repository -> db: Actualizar recorridos.json
    repository --> service: Recorrido
    deactivate repository
    service --> controller: Recorrido
    controller --> view: Éxito
else Nombre duplicado
    service --> controller: Error
    controller --> view: Mostrar error
end

deactivate service
deactivate controller
view --> admin: Refrescar lista de recorridos
deactivate view

@enduml
