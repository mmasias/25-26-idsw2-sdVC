@startuml
title "Diagrama de Secuencia - Listar/Abrir Espacios"

actor "Administrador" as admin
boundary "MapaView" as view
control "EspacioController" as controller
control "VisitaService" as service
control "EspacioRepository" as repository
database "JSON" as db

admin -> view: Cargar vista del mapa
activate view
view -> controller: obtenerEspaciosPlantaActual()
activate controller
controller -> service: obtenerEspaciosPorPlanta(...)
activate service
service -> repository: findUniversidad()
activate repository
repository -> db: Leer universidad.json
repository --> service: Universidad
deactivate repository
service --> controller: List<Espacio>
deactivate service
controller --> view: Espacios para renderizar
deactivate controller
view --> admin: Mostrar mapa con espacios
deactivate view

@enduml
