@startuml
title Diagrama de Secuencia - Iniciar Sesión

actor "Administrador" as Admin
participant "CliController" as CLI
participant "AdminDashboardConsole" as Console
participant "LoginUseCase" as UC
participant "AdminRepository" as Repo
participant "Admin" as Entity
database "JSON (administrators.json)" as DB

Admin -> CLI: Iniciar aplicación --mode=admin
activate CLI
CLI -> Console: start()
activate Console
Console -> Admin: Solicitar credenciales
Admin --> Console: usuario, contraseña
Console -> UC: execute(usuario, contraseña)
activate UC
UC -> Repo: findByUsername(usuario)
activate Repo
Repo -> DB: Leer datos
activate DB
DB --> Repo: JSON data
deactivate DB
Repo -> Entity: mapToEntity(data)
activate Entity
Entity --> Repo: adminEntity
deactivate Entity
Repo --> UC: adminEntity
deactivate Repo
UC -> Entity: checkPassword(contraseña)
activate Entity
Entity --> UC: valid
deactivate Entity
alt Credenciales Válidas
    UC --> Console: Success
    Console --> Admin: Mostrar Dashboard
else Credenciales Inválidas
    UC --> Console: Failure
    deactivate UC
    Console --> Admin: Mostrar Error
end
deactivate Console
deactivate CLI

@enduml
