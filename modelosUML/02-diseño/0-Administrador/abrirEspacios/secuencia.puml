@startuml
title Diagrama de Secuencia - Abrir Espacios

actor "Administrador" as Admin
participant "SpaceCrudConsole" as Console
participant "ListSpacesUseCase" as UC
participant "SpaceRepository" as Repo
participant "Space" as Entity
database "JSON (spaces.json)" as DB

Admin -> Console: Seleccionar "Gestionar Espacios"
activate Console
Console -> UC: execute()
activate UC
UC -> Repo: findAll()
activate Repo
Repo -> DB: Leer espacios
activate DB
DB --> Repo: JSON data
deactivate DB
Repo -> Entity: mapToEntities(data)
activate Entity
Entity --> Repo: List<Space>
deactivate Entity
Repo --> UC: List<Space>
deactivate Repo
UC --> Console: List<Space>
deactivate UC
Console --> Admin: Mostrar lista de espacios

Admin -> Console: Filtrar espacios (criterio)
Console -> UC: execute(criterio)
activate UC
UC -> Repo: findByCriterio(criterio)
activate Repo
Repo --> UC: List<Space>
deactivate Repo
UC --> Console: List<Space>
deactivate UC
Console --> Admin: Mostrar lista filtrada
deactivate Console

@enduml
