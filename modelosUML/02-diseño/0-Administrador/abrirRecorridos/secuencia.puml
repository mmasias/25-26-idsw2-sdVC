@startuml
title Diagrama de Secuencia - Abrir Recorridos

actor "Administrador" as Admin
participant "RouteCrudConsole" as Console
participant "ListRoutesUseCase" as UC
participant "RouteRepository" as Repo
participant "Route" as Entity
database "JSON (routes.json)" as DB

Admin -> Console: Seleccionar "Gestionar Recorridos"
activate Console
Console -> UC: execute()
activate UC
UC -> Repo: findAll()
activate Repo
Repo -> DB: Leer recorridos
activate DB
DB --> Repo: JSON data
deactivate DB
Repo -> Entity: mapToEntities(data)
activate Entity
Entity --> Repo: List<Route>
deactivate Entity
Repo --> UC: List<Route>
deactivate Repo
UC --> Console: List<Route>
deactivate UC
Console --> Admin: Mostrar lista de recorridos

Admin -> Console: Filtrar recorridos (criterio)
Console -> UC: execute(criterio)
activate UC
UC -> Repo: findByCriterio(criterio)
activate Repo
Repo --> UC: List<Route>
deactivate Repo
UC --> Console: List<Route>
deactivate UC
Console --> Admin: Mostrar lista filtrada
deactivate Console

@enduml
