@startuml
title "Diagrama de Secuencia - Seleccionar Recorrido"

actor "Visitante" as visitor
boundary "MapaView" as view
control "VisitaController" as controller
control "VisitaService" as service
control "RecorridoRepository" as repository
entity "Visita" as visit

visitor -> view: Selecciona un recorrido de la lista
activate view
view -> controller: iniciarRecorrido(idRecorrido)
activate controller
controller -> service: iniciarRecorrido(idRecorrido)
activate service
service -> repository: obtenerPorId(idRecorrido)
activate repository
repository --> service: Recorrido
deactivate repository
service -> visit: setCurrentRecorridoId(idRecorrido)
service -> visit: setCurrentEspacioId(primerEspacioId)
service --> controller: Recorrido
deactivate service
controller --> view: Recorrido seleccionado
deactivate controller
view --> visitor: Muestra el primer espacio del recorrido en el mapa
deactivate view

@enduml
