@startuml
title "Diagrama de Secuencia - Seleccionar Recorrido"

actor "Visitante" as visitor
boundary "MapaView" as view
control "RecorridoController" as controller
control "RecorridoRepository" as repository

visitor -> view: Selecciona un recorrido de la lista
activate view
view -> controller: obtenerPorId(idRecorrido)
activate controller
controller -> repository: obtenerPorId(idRecorrido)
activate repository
repository --> controller: Recorrido
deactivate repository
controller --> view: Confirmación (éxito)
deactivate controller
view --> visitor: Muestra mensaje de éxito
view -> view: Cargar recorrido en el contexto
view --> visitor: Muestra el primer espacio del recorrido
deactivate view

@enduml
