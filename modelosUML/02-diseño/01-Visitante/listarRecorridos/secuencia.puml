@startuml
title "Diagrama de Secuencia - Listar Recorridos"

actor "Visitante" as visitor
boundary "MapaView" as view
control "VisitaController" as controller
control "VisitaService" as service
control "RecorridoRepository" as repository

visitor -> view: Pulsa "T" (Tours)
activate view
view -> controller: obtenerRecorridos()
activate controller
controller -> service: obtenerRecorridos()
activate service
service -> repository: obtenerTodos()
activate repository
repository --> service: List<Recorrido>
deactivate repository
service --> controller: List<Recorrido>
deactivate service
controller --> view: List<Recorrido>
deactivate controller
view --> visitor: Muestra lista de recorridos disponibles
deactivate view

@enduml
