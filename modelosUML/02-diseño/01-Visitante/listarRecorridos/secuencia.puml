@startuml
title "Diagrama de Secuencia - Listar Recorridos (Visitante)"

actor "Visitante" as visitor
boundary "RecorridoDialog" as view
control "RecorridoController" as controller
control "VisitaService" as service
control "RecorridoRepository" as repository
database "JSON" as db

visitor -> view: Pulsa "T" para ver tours
activate view
view -> controller: obtenerRecorridos()
activate controller
controller -> service: obtenerRecorridos()
activate service
service -> repository: findAll()
activate repository
repository -> db: Leer recorridos.json
repository --> service: List<Recorrido>
deactivate repository
service --> controller: List<Recorrido>
deactivate service
controller --> view: Lista de recorridos
deactivate controller
view --> visitor: Muestra lista para seleccionar
deactivate view

@enduml
