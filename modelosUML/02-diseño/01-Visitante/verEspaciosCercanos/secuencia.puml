@startuml
title "Diagrama de Secuencia - Ver Espacios Cercanos"

actor "Visitante" as visitor
boundary "MapaView" as view
control "VisitaController" as controller
control "VisitaService" as service
control "EspacioRepository" as repository

visitor -> view: Solicita ver espacios cercanos (tecla 'C')
activate view
view -> controller: obtenerEspaciosCercanos()
activate controller
controller -> service: obtenerEspaciosCercanos()
activate service
service -> service: obtenerEspacioActual()
service -> repository: obtenerTodosLosEspacios()
activate repository
repository --> service: List<Espacio>
deactivate repository
service -> service: Calcular distancias y filtrar top 5
service --> controller: List<Espacio>
deactivate service
controller --> view: List<Espacio>
deactivate controller
view --> visitor: Resalta los espacios cercanos en el mapa/lista
deactivate view

@enduml
