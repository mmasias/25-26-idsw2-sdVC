@startuml
title "Diagrama de Secuencia - Ver Espacios Cercanos (Adyacencia)"

actor "Visitante" as visitor
boundary "MapaView" as view
control "MapContext" as context
entity "GridMapaRenderer" as renderer

visitor -> view: Pulsa tecla "C"
activate view

view -> context: getCursor()
note right: Obtiene (x, y) actual

view -> renderer: spaceAt(x, y-1) [Norte]
activate renderer
renderer --> view: Espacio (si existe)
view -> renderer: spaceAt(x, y+1) [Sur]
view -> renderer: spaceAt(x-1, y) [Oeste]
view -> renderer: spaceAt(x+1, y) [Este]
deactivate renderer

view -> view: Recolectar nombres de espacios únicos
view -> context: setStatusMessage("Al lado: [Nombres...]")
view --> visitor: Muestra adyacentes en la barra de estado
deactivate view

@enduml
