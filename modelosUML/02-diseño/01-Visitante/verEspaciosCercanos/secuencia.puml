@startuml
title "Diagrama de Secuencia - Ver Espacios Cercanos"

actor "Visitante" as visitor
boundary "MapaView" as view
control "EspacioController" as controller
control "VisitaService" as service
control "EspacioRepository" as repository

visitor -> view: Pulsa tecla para ver cercanos
activate view
view -> controller: obtenerEspaciosCercanos(idEspacioActual)
activate controller
controller -> service: obtenerEspaciosCercanos(idEspacioActual)
activate service
service -> repository: findAll()
activate repository
repository --> service: List<Espacio>
deactivate repository
service -> service: Calcular distancias y ordenar
service --> controller: List<Espacio> (cercanos)
deactivate service
controller --> view: Lista de espacios cercanos
deactivate controller
view --> visitor: Muestra la lista de espacios
deactivate view

@enduml
