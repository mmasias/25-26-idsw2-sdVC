@startuml
title "Diagrama de Secuencia - Ver Detalles"

actor "Visitante" as visitor
boundary "MapaView" as view
control "EspacioController" as controller
control "EspacioRepository" as repository

visitor -> view: Pulsa "Enter" sobre un espacio
activate view
view -> controller: obtenerUniversidad()
activate controller
controller -> repository: obtenerUniversidad()
activate repository
repository --> controller: Universidad
deactivate repository
controller --> view: Universidad (con datos de espacios)
deactivate controller
view -> view: Buscar detalles del espacio seleccionado
view --> visitor: Muestra diálogo con descripción y tipo detallado
deactivate view

@enduml
