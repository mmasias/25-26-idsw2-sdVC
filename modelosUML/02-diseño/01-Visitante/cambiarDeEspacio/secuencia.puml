@startuml
title "Diagrama de Secuencia - Cambiar de Espacio (En Recorrido)"

actor "Visitante" as visitor
boundary "MapaView" as view
control "VisitaController" as controller
control "VisitaService" as service

visitor -> view: Pulsa "A" (anterior) o "D" (siguiente)
activate view
view -> controller: cambiarEspacioRecorrido(direccion)
activate controller
controller -> service: navegarRecorrido(direccion)
activate service
service --> controller: Espacio
deactivate service
controller --> view: Nuevo espacio actual
deactivate controller
view --> visitor: Actualiza mapa y panel de detalles
deactivate view

@enduml
