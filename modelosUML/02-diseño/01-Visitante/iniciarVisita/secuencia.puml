@startuml
title "Diagrama de Secuencia - Iniciar Visita"

actor "Visitante" as visitor
boundary "TerminalApp" as app
control "VisitaController" as controller
control "VisitaService" as service
entity "Visita" as visit

visitor -> app: Inicia aplicación (modo visitante)
activate app
app -> controller: iniciar()
activate controller
controller -> service: iniciarVisita()
activate service
service -> visit: new()
service --> controller: Visita
deactivate service
controller --> app: Visita
deactivate controller
app --> visitor: Muestra menú de bienvenida
deactivate app

@enduml
