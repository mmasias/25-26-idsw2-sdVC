@startuml
title "Diagrama de Secuencia - Buscar Espacio"

actor "Visitante" as visitor
boundary "DialogForm" as view
control "EspacioController" as controller
control "EspacioRepository" as repository
entity "Universidad" as uni
entity "Region" as reg

visitor -> view: Introduce término de búsqueda
activate view
view -> controller: buscarEspacios(termino)
activate controller
controller -> repository: obtenerTodosLosEspacios()
activate repository
repository -> uni: obtenerTodosLosEspacios()
activate uni
uni -> reg: obtenerPlantas()
activate reg
reg --> uni: List<Planta>
deactivate reg
uni --> repository: List<Espacio>
deactivate uni
repository --> controller: List<Espacio>
deactivate repository
controller -> controller: filtrarPorTermino(termino)
controller --> view: Lista de resultados
deactivate controller
view --> visitor: Muestra espacios encontrados
deactivate view

@enduml
