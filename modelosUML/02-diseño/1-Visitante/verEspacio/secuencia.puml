@startuml
title Diagrama de Secuencia - Ver Espacio

actor "Visitante" as Visitor
participant "FloorMapConsole" as Console
participant "GetSpaceUseCase" as UC
participant "SpaceRepository" as Repo
participant "FloorRenderer" as Renderer

Visitor -> Console: Solicitar ver espacio actual
activate Console
Console -> UC: execute(currentId)
activate UC
UC -> Repo: findById(currentId)
activate Repo
Repo --> UC: space
deactivate Repo
UC --> Console: space
deactivate UC
Console -> Renderer: render(space)
activate Renderer
Renderer --> Console: asciiArt
deactivate Renderer
Console --> Visitor: Mostrar mapa ASCII con el espacio resaltado
deactivate Console

@enduml
