@startuml
title Diagrama de Secuencia - Ver Espacios de Planta

actor "Visitante" as Visitor
participant "FloorMapConsole" as Console
participant "ListSpacesByFloorUseCase" as UC
participant "SpaceRepository" as Repo
participant "FloorRenderer" as Renderer

Visitor -> Console: Seleccionar Planta
activate Console
Console -> UC: execute(floorId)
activate UC
UC -> Repo: findByFloor(floorId)
activate Repo
Repo --> UC: List<Space>
deactivate Repo
UC --> Console: List<Space>
deactivate UC
Console -> Renderer: renderFloor(floorId, spaces)
activate Renderer
Renderer --> Console: asciiMap
deactivate Renderer
Console --> Visitor: Mostrar mapa de planta y lista de espacios
deactivate Console

@enduml
