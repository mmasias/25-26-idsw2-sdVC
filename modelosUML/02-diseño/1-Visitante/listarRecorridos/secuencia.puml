@startuml
title Diagrama de Secuencia - Listar Recorridos

actor "Visitante" as Visitor
participant "MenuVisitor" as Menu
participant "ListRoutesUseCase" as UC
participant "RouteRepository" as Repo
database "JSON (routes.json)" as DB

Visitor -> Menu: Seleccionar "Ver Recorridos"
activate Menu
Menu -> UC: execute()
activate UC
UC -> Repo: findAll()
activate Repo
Repo -> DB: Leer rutas
activate DB
DB --> Repo: JSON data
deactivate DB
Repo --> UC: List<Route>
deactivate Repo
UC --> Menu: List<Route>
deactivate UC
Menu --> Visitor: Mostrar lista de recorridos
deactivate Menu

@enduml
